# Lines starting with # are comments and are never checked.
# Even a line like this one, with AKIAIOSFODNN7EXAMPLE in it, is skipped.
export API_KEY="your-api-key-here"
APP_NAME='my-cool-app' # the app name, quoted
DEBUG=true # inline comments are stripped before the check
PASSWORD=hunter2
EMPTY_VALUE=
BARE_KEY
DATABASE_URL=postgres://user:password@localhost:5432/myapp
